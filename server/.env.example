# Copy to .env and adjust. Never commit .env (see .gitignore). Non-secret
# game-server settings live in ../config.yml; browser settings live in
# client/.env.local (see client/.env.example).

# Postgres — prefer Supabase's direct IPv6 URI for this long-lived server.
# When direct IPv6 is unavailable, use the *transaction* pooler (port 6543),
# not the session pooler (port 5432): session mode pins one Postgres
# connection per pooled client for that client's whole life, so our pool
# permanently occupies PG_POOL_MAX of the pooler's pool_size (15 by default)
# and any second client — a rolling deploy's old machine, a migration, a
# tool run — trips EMAXCONNSESSION. Transaction mode multiplexes instead.
# Nothing here needs session state: no LISTEN/NOTIFY, no SET/SET SESSION, no
# temp tables, no cursors, no named prepared statements (node-pg does not use
# them by default), and the only advisory lock is pg_advisory_xact_lock, which
# is transaction-scoped. Keep the database in the same geographic region as
# the game server.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Persistent application connections. Keep this within the database/pooler's
# configured connection budget; accepted range is 1..50. On the transaction
# pooler this bounds concurrent in-flight queries rather than reserved
# Postgres connections. On the session pooler it must stay under pool_size
# (15 by default) with headroom for migrations/tools.
PG_POOL_MAX=10

# Supabase auth (server-side token verification)
# Project URL, e.g. https://PROJECT_REF.supabase.co
SUPABASE_URL=

# Development only — NEVER set these in production.
# DEV_AUTH=1 accepts fake tokens like "dev-alice" instead of Supabase JWTs
# (used by the headless playtest harness in server/src/playtest/).
# DEV_COMMANDS=1 enables in-game GM chat commands: /i <item> [count],
# /spawn <monster>, /goto <x> <y> [z], /level <n>, /heal, /where.
#DEV_AUTH=1
#DEV_COMMANDS=1

# Optional deployment overrides for config.yml. CONFIG_PATH may be absolute or
# relative to the process working directory.
#CONFIG_PATH=../config.yml
#SERVER_PORT=4000
#TRUST_PROXY=1
#MAP_NAME=otservbr
#SPAWN_TOWN=Thais
#CREATURES_ENABLED=1
