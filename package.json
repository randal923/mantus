{
  "name": "tibia",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "protocol"
  ],
  "scripts": {
    "dev": "concurrently -k -n next.js,server,storybook -c cyan,magenta,yellow \"yarn workspace client dev\" \"yarn workspace server dev\" \"yarn workspace client storybook --no-open\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "assets:import": "node tools/importTibiaAssets.mjs",
    "items:convert": "node tools/convertCanaryItems.mjs",
    "items:foods": "node tools/importCanaryFoods.mjs",
    "items:stowable": "node tools/importCanaryStowableItems.mjs",
    "chests:import": "node tools/importCanaryChests.mjs",
    "raids:import": "node tools/importCanaryRaids.mjs",
    "item:override": "node tools/createItemOverride.mjs",
    "items:catalog": "node tools/buildItemCatalog.mjs && node tools/buildWikiItemCatalog.mjs && yarn workspace server creature-loot:build && node tools/buildProficiencySprites.mjs && node tools/buildItemAnimations.mjs",
    "animations:import": "node tools/importAppearanceAnimations.mjs",
    "map:convert": "node tools/convertOtbm.mjs map/otservbr.otbm && node tools/buildMinimapTiles.mjs",
    "minimap:build": "node tools/buildMinimapTiles.mjs",
    "hunts:build": "node tools/buildHuntingPlaces.mjs",
    "creatures:import": "node tools/importCanaryCreatures.mjs",
    "npcs:import": "node tools/importCanaryNpcs.mjs && node tools/buildNpcShopCategories.mjs",
    "npcs:shop-categories": "node tools/buildNpcShopCategories.mjs",
    "spells:import": "node tools/importCanarySpells.mjs",
    "outfits:import": "node tools/importCanaryOutfits.mjs",
    "store:catalog": "node tools/importCanaryStoreCatalog.mjs",
    "store:assets": "node tools/importOtclientStoreAssets.mjs",
    "bestiary:import": "node tools/importCanaryBestiary.mjs",
    "achievements:import": "node tools/importCanaryAchievements.mjs",
    "cyclopedia:assets": "node tools/importOtclientCyclopediaAssets.mjs",
    "rewardwall:assets": "node tools/importOtclientRewardWallAssets.mjs",
    "imbuing:assets": "node tools/importOtclientImbuementAssets.mjs",
    "parity:inventory": "node tools/buildCanaryParityInventory.mjs",
    "parity:world-actions": "node tools/buildWorldActionParityInventory.mjs",
    "parity:check": "node tools/verifyCanaryParityInventory.mjs",
    "character:set-level": "node --env-file-if-exists=.env tools/setCharacterLevel.mjs",
    "character:delete": "node --env-file-if-exists=.env tools/deleteCharacter.mjs",
    "character:grant-outfits": "node --env-file-if-exists=.env tools/grantAllOutfits.mjs",
    "coins:grant": "node --env-file-if-exists=.env tools/grantCoins.mjs",
    "imbuement:grant-materials": "node --env-file-if-exists=.env tools/grantImbuementMaterials.mjs",
    "gems:grant": "node --env-file-if-exists=.env tools/grantGems.mjs",
    "typecheck": "yarn workspace @tibia/protocol typecheck && yarn workspace server typecheck && yarn workspace client typecheck",
    "test": "yarn test:tools && yarn workspace client test && yarn workspace server test",
    "test:monsters": "yarn workspace client test:e2e:monsters",
    "test:monsters:cpu": "yarn workspace client test:e2e:monsters:cpu",
    "test:monsters:gpu": "yarn workspace client test:e2e:monsters:gpu",
    "test:players": "yarn workspace server playtest:players",
    "test:tools": "node --test tools/*.test.mjs && yarn parity:check",
    "db:migrate": "yarn workspace server db:migrate",
    "db:reconcile-loose-inventory": "yarn workspace server db:reconcile-loose-inventory",
    "db:cleanup-partial-world-seed": "yarn workspace server db:cleanup-partial-world-seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
