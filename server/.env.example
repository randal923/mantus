# Copy to .env and adjust. Never commit .env (see .gitignore). Non-secret
# game-server settings live in ../config.yml; browser settings live in
# client/.env.local (see client/.env.example).

# Postgres. Production runs on the unmanaged Fly Postgres app `mantus-db`
# (region dfw, same as the game server; Postgres 18) and connects over the
# private network as the `mantus` role:
#   postgres://mantus:PASSWORD@mantus-db.flycast:5432/mantus
# That value lives only in the Fly secret (`fly secrets set -a mantus
# DATABASE_URL=...`), never in a checked-in file. It is a direct connection
# (haproxy → primary, no pgbouncer), so session state, advisory locks and
# `yarn db:migrate` all work against it. From a laptop the flycast address is
# unreachable: tunnel first with `fly proxy 15432:5432 -a mantus-db` and use
# postgres://mantus:PASSWORD@localhost:15432/mantus.
#
# Local development keeps its own database. The Supabase project that used to
# host production still holds a frozen copy of the 2026-08-28 data and doubles
# as the dev database; when pointing at it, use the *transaction* pooler
# (port 6543) for the server and the session port (5432) for migrations —
# see scripts/migrate.ts. Keep the database in the same geographic region as
# the game server.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Persistent application connections, accepted range 1..50. On Fly Postgres
# each one is a real backend, so keep the total across every process (server,
# migrations, tools) under the cluster's max_connections. On the Supabase
# transaction pooler this bounds concurrent in-flight queries instead.
PG_POOL_MAX=25

# Supabase auth (server-side token verification)
# Project URL, e.g. https://PROJECT_REF.supabase.co
SUPABASE_URL=

# Development only — NEVER set these in production.
# DEV_AUTH=1 accepts fake tokens like "dev-alice" instead of Supabase JWTs
# (used by the headless playtest harness in server/src/playtest/).
# DEV_COMMANDS=1 enables in-game GM chat commands: /i <item> [count],
# /spawn <monster>, /goto <x> <y> [z], /level <n>, /heal, /where.
#DEV_AUTH=1
#DEV_COMMANDS=1

# Optional deployment overrides for config.yml. CONFIG_PATH may be absolute or
# relative to the process working directory.
#CONFIG_PATH=../config.yml
#SERVER_PORT=4000
#TRUST_PROXY=1
#MAP_NAME=otservbr
#SPAWN_TOWN=Thais
#CREATURES_ENABLED=1

# Pix payments via Mercado Pago (all optional; leaving them unset disables
# real-money coin top-ups). The access token comes from the Mercado Pago
# application (Developers panel > Your integrations); use TEST credentials in
# dev. The webhook secret appears when the webhook URL
# (https://<host>/api/payments/mercadopago/webhook, topic "payments") is
# registered; without it the webhook endpoint stays off and payments settle
# through the 60 s reconciliation sweep instead.
#MERCADOPAGO_ACCESS_TOKEN=
# Comma-separated to rotate: put the new secret first and keep the old one
# until Mercado Pago has switched, then drop it.
#MERCADOPAGO_WEBHOOK_SECRET=
# Public notification URL passed on each charge; optional when the webhook is
# registered in the Mercado Pago panel.
#PIX_NOTIFICATION_URL=
# payer.email sent to Mercado Pago when the account has no e-mail on file.
#PIX_PAYER_EMAIL_FALLBACK=
