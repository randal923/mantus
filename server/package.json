    "db:grant-gold": "tsx --env-file-if-exists=./.env --env-file-if-exists=.env scripts/grantGold.ts",
    "db:backfill-bound": "tsx --env-file-if-exists=./.env --env-file-if-exists=.env scripts/backfillBoundContainers.ts",
